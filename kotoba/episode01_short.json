  "scenes": [
    {
      "title": "消えた宝箱",
      "lines": [
        {
          "sfx": "intro"
        },
        {
          "who": "narrator",
          "text": "ことば幻獣ラジオ！　言葉の力で育つ、しずくの島。ポコたちが宝箱を開けようとすると……。"
        },
        {
          "who": "poko",
          "text": "ない！　金色どんぐりの宝箱が消えたのだ！　昨日はここにあったのに！"
        },
        {
          "sfx": "mystery"
        },
        {
          "who": "mina",
          "text": "台座には、小さな足跡が残っています。"
        },
        {
          "who": "poko",
          "text": "犯人はチビモグなのだ！　あんな小さな幻獣なら、すぐ捕まえられるのだ！"
        },
        {
          "who": "luna",
          "text": "ポコ。小さいから弱いと見くびるのは、よくないわ。見くびるって、相手の力を実際より低く考えることよ。"
        },
        {
          "who": "poko",
          "text": "見くびる？　でも、ぼくには犯人がわかったのだ！"
        }
      ]
    },
    {
      "title": "ぶっきらぼうな返事",
      "lines": [
        {
          "sfx": "magic"
        },
        {
          "who": "mina",
          "text": "そこへチビモグが現れました。問いかけると、『知らない。どいて』とだけ答えます。"
        },
        {
          "who": "poko",
          "text": "なんてぶっきらぼうなのだ！　ぶっきらぼうな返事は、きっと隠し事がある証拠なのだ！"
        },
        {
          "who": "luna",
          "text": "ぶっきらぼうは、そっけない話し方。でも、そうだから犯人とは限らないわ。"
        },
        {
          "who": "poko",
          "text": "えー？　ぼくの推理は完璧なのだ！"
        },
        {
          "who": "luna",
          "text": "それは、ひとりよがりよ。自分の考えだけが正しいと思い込んでいるわ。"
        },
        {
          "who": "mina",
          "text": "みんなにも質問です。チビモグがぶっきらぼうだったことだけで、犯人だと言えるでしょうか？"
        },
        {
          "quiz_pause_ms": 5100
        },
        {
          "who": "poko",
          "text": "……言えない、のだ。ぼくのひとりよがりだったかもしれない。"
        },
        {
          "sfx": "ding"
        }
      ]
    },
    {
      "title": "宝箱の意外な使い道",
      "lines": [
        {
          "who": "mina",
          "text": "突然、虹色の木の根元に水が流れ込みました！　近くには、幻獣の卵があります！"
        },
        {
          "sfx": "alarm"
        },
        {
          "who": "poko",
          "text": "たいへんなのだ！　いつもの橋から助けに行くのだ！"
        },
        {
          "who": "luna",
          "text": "その橋は水で通れない！　高い岩を回りましょう。臨機応変に道を変えるのよ！"
        },
        {
          "who": "poko",
          "text": "臨機応変！　状況に合わせてやり方を変えるのだね！"
        },
        {
          "who": "mina",
          "text": "三人が回り込むと、宝箱が水路のそばにありました。チビモグたちが、流れる水を止めるために運んでいたんです！"
        },
        {
          "who": "poko",
          "text": "宝箱は盗まれてなかったのだ！　あんな小さな体で……ぼく、チビモグを見くびっていたのだ。"
        },
        {
          "who": "luna",
          "text": "そうね。チビモグは卵を守ろうと、臨機応変に宝箱を使ったのよ。"
        },
        {
          "who": "poko",
          "text": "ごめんね、チビモグ。"
        },
        {
          "who": "mina",
          "text": "チビモグは少し黙っています。心にわだかまりが残っているのかもしれません。"
        },
        {
          "who": "luna",
          "text": "わだかまりは、心に残る、すっきりしない気持ち。謝ればすぐに消えるとは限らないの。"
        },
        {
          "who": "poko",
          "text": "わだかまりがなくなるまで、ぼくも優しく接するのだ！"
        },
        {
          "sfx": "win"
        }
      ]
    },
    {
      "title": "耳で挑戦！ことばクイズ",
      "lines": [
        {
          "sfx": "quiz"
        },
        {
          "who": "narrator",
          "text": "さあ、最後は三問！　声に出して答えてね。"
        },
        {
          "who": "narrator",
          "text": "第一問。相手を弱いと決めつける。これは、一、見くびる。二、わだかまり。"
        },
        {
          "quiz_pause_ms": 5100
        },
        {
          "who": "luna",
          "text": "正解は一、見くびる。"
        },
        {
          "who": "narrator",
          "text": "第二問。自分の考えばかり正しいと思う。これは、一、臨機応変。二、ひとりよがり。"
        },
        {
          "quiz_pause_ms": 5100
        },
        {
          "who": "poko",
          "text": "正解は二、ひとりよがり！　さっきのぼくなのだ。"
        },
        {
          "who": "narrator",
          "text": "第三問。橋が通れないので、安全な道に変更した。これは、一、臨機応変。二、ぶっきらぼう。"
        },
        {
          "quiz_pause_ms": 5100
        },
        {
          "who": "mina",
          "text": "正解は一、臨機応変。状況に合わせて対応を変えることです。"
        },
        {
          "who": "narrator",
          "text": "今日の言葉は、見くびる、ぶっきらぼう、ひとりよがり、臨機応変、わだかまり。次の物語でも耳で推理してね。"
        },
        {
          "sfx": "ending"
        }
      ]
    }
  ]
}
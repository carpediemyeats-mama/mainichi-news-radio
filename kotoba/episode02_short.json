  "scenes": [
    {
      "title": "真夜中の十三番目の音",
      "lines": [
        {
          "sfx": "intro"
        },
        {
          "who": "narrator",
          "text": "ことば幻獣ラジオ！　今夜は、星祭りのしずくの島。真夜中、時計塔の鐘が鳴りました。"
        },
        {
          "sfx": "bell13"
        },
        {
          "who": "poko",
          "text": "いま、十三回鳴ったのだ！　十二回のあと、チリンって！　うわさの幽霊が来たのだ！"
        },
        {
          "who": "mina",
          "text": "幽霊の話は、みんながまことしやかに話しているだけ。ほんとうか、確かめた人はいません。"
        },
        {
          "who": "luna",
          "text": "まことしやか、は、本当らしく聞こえること。証拠があるとは限らないわ。"
        },
        {
          "who": "poko",
          "text": "でも、川にかかる月の橋まで消えたのだ！"
        },
        {
          "who": "luna",
          "text": "霧で見えないだけかもしれない。調べる前から決めつけるのは予断よ。"
        },
        {
          "who": "poko",
          "text": "予断……。じゃあ、幽霊だと思い込まずに調べるのだ！"
        },
        {
          "sfx": "mystery"
        }
      ]
    },
    {
      "title": "銀色の糸と危険な橋",
      "lines": [
        {
          "who": "mina",
          "text": "時計塔の扉には赤い紙。『今夜、月の橋を渡るな』。"
        },
        {
          "who": "poko",
          "text": "なんだか怖いのだ。あっ、時計の歯車に、銀色の糸がある！"
        },
        {
          "who": "luna",
          "text": "よく目を凝らして。目を凝らす、は、注意してじっとよく見ることよ。"
        },
        {
          "who": "mina",
          "text": "糸の先には小さな鈴。十二回目の大きな鐘のあと、鈴が一回鳴る仕組みです。"
        },
        {
          "who": "poko",
          "text": "幽霊じゃなく、鈴だったのだ！　でも、誰がつけたのだ？"
        },
        {
          "who": "luna",
          "text": "糸は丁寧に結んである。誰かが意図的に、つまり目的があって取りつけたみたい。"
        },
        {
          "who": "mina",
          "text": "ここでみんなに問題。十三番目の音は、なぜ大きな鐘と違う、小さな鈴だったのでしょう？"
        },
        {
          "quiz_pause_ms": 5100
        },
        {
          "who": "poko",
          "text": "わかったかも！　いつもと違う音で、誰かに何かを知らせたかったのだ！"
        },
        {
          "sfx": "alarm"
        },
        {
          "who": "mina",
          "text": "川の水が増えています！　霧で見えない橋を渡るのは危険です！"
        }
      ]
    },
    {
      "title": "鐘の本当の意味",
      "lines": [
        {
          "who": "poko",
          "text": "向こう岸に小さな幻獣がいるのだ！　危ない、渡っちゃだめなのだー！"
        },
        {
          "who": "luna",
          "text": "声が届かない！　あの丘から、灯りを三回点滅させましょう！"
        },
        {
          "sfx": "magic"
        },
        {
          "who": "mina",
          "text": "一回、二回、三回！　向こうも三回、灯りを返しました。安全な道へ引き返しています！"
        },
        {
          "who": "poko",
          "text": "よかった！　でも、十三番目の鈴って、何だったのだ？"
        },
        {
          "who": "mina",
          "text": "時計塔の番人が取りつけたそうです。橋の危険を知らせるため、意図的に鳴る仕組みにしたんですね。"
        },
        {
          "who": "luna",
          "text": "いつもと違う音なら、みんなが気づく。理にかなう工夫ね。理にかなう、は、ちゃんと理由があって納得できること。"
        },
        {
          "who": "poko",
          "text": "でも、合図の意味が伝わってなかったから、まことしやかな幽霊のうわさになっちゃったのだ。"
        },
        {
          "who": "mina",
          "text": "うわさを信じる前に、目を凝らして確かめたから、仕組みがわかりました。"
        },
        {
          "who": "luna",
          "text": "予断を持たずに考えれば、ちゃんと理由が見えてくるのよ。"
        },
        {
          "sfx": "win"
        }
      ]
    },
    {
      "title": "耳で挑戦！ことばクイズ",
      "lines": [
        {
          "sfx": "quiz"
        },
        {
          "who": "narrator",
          "text": "今日の語彙力ミッションは三問。よく聞いて、答えてね。"
        },
        {
          "who": "narrator",
          "text": "第一問。根拠がないのに、本当らしく聞こえる話。これは、一、まことしやか。二、目を凝らす。"
        },
        {
          "quiz_pause_ms": 5100
        },
        {
          "who": "mina",
          "text": "正解は一、まことしやか。"
        },
        {
          "who": "narrator",
          "text": "第二問。調べる前から幽霊と決めつける。これは、一、予断。二、意図的。"
        },
        {
          "quiz_pause_ms": 5100
        },
        {
          "who": "luna",
          "text": "正解は一、予断。意図的は、目的を持ってわざとすることよ。"
        },
        {
          "who": "narrator",
          "text": "第三問。いつもと違う鈴で、危険を知らせる。理由があって納得できる工夫。これは、一、理にかなう。二、目を凝らす。"
        },
        {
          "quiz_pause_ms": 5100
        },
        {
          "who": "poko",
          "text": "正解は一、理にかなう！　それに、銀の糸を見つけるときは目を凝らしたのだ！"
        },
        {
          "who": "narrator",
          "text": "今日の言葉は、まことしやか、予断、目を凝らす、意図的、理にかなう。また次の事件で会いましょう！"
        },
        {
          "sfx": "ending"
        }
      ]
    }
  ]
}
  "sections": [
    {
      "id": "intro",
      "title": "考えは、どこから来る？",
      "target_seconds": 40,
      "lines": [
        {
          "text": "ちょっと、不思議な話をしよう。",
          "pause_ms": 650
        },
        {
          "text": "戦国武将の名前を、ひとりも思い浮かべないで、と言われたら。",
          "pause_ms": 850
        },
        {
          "text": "なぜか、誰かの顔が、ふっと浮かぶことがある。",
          "pause_ms": 1150
        },
        {
          "text": "人間の頭は、考えを止めようとしても、次の考えが現れることがあるんだ。",
          "pause_ms": 800
        },
        {
          "text": "じゃあ、その考えは、いったいどこから来たんだろう。",
          "pause_ms": 1200
        },
        {
          "text": "今日は、頭の中のおしゃべりを、少しだけ観察してみよう。",
          "pause_ms": 850
        }
      ]
    },
    {
      "id": "explore",
      "title": "頭の中のおしゃべりを探検",
      "target_seconds": 110,
      "lines": [
        {
          "text": "今のままで大丈夫。目は開けたままでいいし、少し動いていてもいい。",
          "pause_ms": 1000
        },
        {
          "text": "まずは、周りにある音を、一つだけ見つけてみよう。",
          "pause_ms": 2500
        },
        {
          "text": "近くの音かもしれないし、ずっと遠くの音かもしれない。",
          "pause_ms": 1900
        },
        {
          "text": "何も聞こえなければ、今、静かなんだな。それでいい。",
          "pause_ms": 800
        },
        {
          "text": "次は、今、頭の中にどんな言葉があるか、気づいてみよう。",
          "pause_ms": 1800
        },
        {
          "text": "今日の予定。昨日読んだ漫画。急に出てきた、まったく関係のないこと。",
          "pause_ms": 2500
        },
        {
          "text": "考えは、自分で呼ばなくても現れることがある。",
          "pause_ms": 1500
        },
        {
          "text": "たとえば、空を流れる雲みたいに。形ができて、また変わっていく。",
          "pause_ms": 2400
        },
        {
          "text": "もし考えが出てきたら、あ、今、こんなことを考えていた。と、そっと気づいてみる。",
          "pause_ms": 3300
        },
        {
          "text": "考えを消したり、正しく並べたりする必要はない。",
          "pause_ms": 1600
        },
        {
          "text": "足の裏や手のひらは、今、どんな感じだろう。",
          "pause_ms": 2800
        },
        {
          "text": "床のかたさ、服の感触。どちらでもいい。",
          "pause_ms": 2100
        },
        {
          "text": "合わなければ、また外の音を聴いていてもいい。",
          "pause_ms": 2100
        },
        {
          "text": "そして、あちこちに動く注意を、そのまま眺めてみよう。",
          "pause_ms": 2400
        }
      ]
    },
    {
      "id": "outro",
      "title": "いつもの朝へ",
      "target_seconds": 30,
      "lines": [
        {
          "text": "考えは、今もどこかへ動いているかもしれない。",
          "pause_ms": 1150
        },
        {
          "text": "それを、無理に止めなくてもいい。",
          "pause_ms": 1300
        },
        {
          "text": "今、目に入るものを、一つだけ眺めてみよう。",
          "pause_ms": 1800
        },
        {
          "text": "窓の光でも、机の色でも、なんでもいい。",
          "pause_ms": 1200
        },
        {
          "text": "今日の探検は、ここまで。",
          "pause_ms": 900
        },
        {
          "text": "さて、いつもの朝に戻ろう。",
          "pause_ms": 1400
        }
      ]
    }
  ]
}
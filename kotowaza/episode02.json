  "scenes": [
    {
      "title": "開幕・待ちに待った肉まん作り",
      "lines": [
        {
          "sfx": "intro"
        },
        {
          "who": "narrator",
          "text": "ことわざ事件簿！　今日はお祭りの肉まん屋台。六つのことばを、耳で覚える五分間です。"
        },
        {
          "sfx": "arcade"
        },
        {
          "who": "tomo",
          "text": "やっと来たのだ！　ぼく、この肉まん作り体験を首を長くして待っていたのだ！"
        },
        {
          "who": "mika",
          "text": "首を長くする、は、楽しみにずっと待つこと。首が本当に伸びるわけじゃないよ。"
        },
        {
          "who": "manager",
          "text": "いらっしゃい！　私は肉まん作りの先生。今日は皮を包むコツを教えます。何か質問は？"
        },
        {
          "who": "narrator",
          "text": "ところが、みんなが静かになって、誰も話し始めません。"
        },
        {
          "who": "tomo",
          "text": "じゃあ、ぼくが口火を切るのだ！　先生、皮はどうやって閉じるんですか？"
        },
        {
          "who": "mika",
          "text": "トモが最初に質問したね。口火を切る、は、話し合いや物事を最初に始めることだよ。"
        },
        {
          "who": "narrator",
          "text": "ここでひとつ。楽しみに待ち続けるのは、『首を長くする』と『口火を切る』、どちら？"
        },
        {
          "quiz_pause_ms": 4300
        },
        {
          "sfx": "ding"
        },
        {
          "who": "tomo",
          "text": "首を長くする！　ぼくは今日を、ずっと楽しみにしていたのだ！"
        }
      ]
    },
    {
      "title": "ひだが閉じない！ 挑戦の場面",
      "lines": [
        {
          "sfx": "coin"
        },
        {
          "who": "manager",
          "text": "さあ、生地のまん中にあんを置いて、周りの皮を少しずつつまんでね。"
        },
        {
          "who": "tomo",
          "text": "うーん。初めてだから、失敗しそう。やっぱり、やめとこうかな……。"
        },
        {
          "who": "mika",
          "text": "二の足を踏んでいるの？　それは、ためらって行動に移せないこと。"
        },
        {
          "who": "tomo",
          "text": "そうなのだ。肉まんは食べたいけど、作るのはちょっと怖いのだ。"
        },
        {
          "who": "manager",
          "text": "大丈夫。失敗しても、練習すれば上手になるよ。"
        },
        {
          "who": "tomo",
          "text": "よし！　二の足を踏むのは、もうおしまい！　やってみるのだ！"
        },
        {
          "sfx": "pop"
        },
        {
          "who": "mika",
          "text": "あっ！　トモの皮から、あんがこぼれそう！　ぎりぎりで持ちこたえて！"
        },
        {
          "who": "narrator",
          "text": "ミカは手に汗を握って見守りました。『手に汗を握る』は、はらはらしながら、緊張して見守ること。"
        },
        {
          "who": "mika",
          "text": "もう少し！　閉じるかな？　手に汗を握る瞬間だね！"
        },
        {
          "sfx": "win"
        },
        {
          "who": "tomo",
          "text": "なんとか閉じたのだ！　でも、見た目は小さなタコみたいなのだ！"
        },
        {
          "who": "manager",
          "text": "初めてなら上出来！　さあ、次は私が包むところを見てね。"
        }
      ]
    },
    {
      "title": "職人のひみつ・二つの驚き",
      "lines": [
        {
          "sfx": "magic"
        },
        {
          "who": "narrator",
          "text": "先生の指が、するすると動きます。あっという間に、きれいなひだが並びました。"
        },
        {
          "who": "tomo",
          "text": "すごい！　ぼく、先生の見事な手つきに舌を巻いたのだ！"
        },
        {
          "who": "mika",
          "text": "『舌を巻く』は、とても感心すること。びっくりして舌を丸める、という意味じゃないよ。"
        },
        {
          "who": "manager",
          "text": "コツはね、あんを乗せすぎないこと。それから、皮のふちを少し残すと、つまみやすいんだ。"
        },
        {
          "who": "tomo",
          "text": "あっ！　ぼくはあんをいっぱい入れすぎて、閉じる場所がなくなったんだ！"
        },
        {
          "who": "mika",
          "text": "なるほど！　それは目から鱗が落ちる発見だね。今までわからなかったことが、急に理解できることだよ。"
        },
        {
          "who": "tomo",
          "text": "目から鱗が落ちる、ってそういうことか！　コツがわかったのだ！"
        },
        {
          "who": "narrator",
          "text": "ここが大事。『舌を巻く』は、すばらしい腕前に感心する。『目から鱗が落ちる』は、新しい発見ですっと理解できる。違いがわかったかな？"
        },
        {
          "who": "manager",
          "text": "じゃあもう一度挑戦！"
        },
        {
          "who": "tomo",
          "text": "今度はあんを少なめにしたのだ。ほら、皮が閉じた！"
        },
        {
          "who": "mika",
          "text": "わあ、上達が速い！　その工夫には、わたしも舌を巻いちゃうよ。"
        },
        {
          "sfx": "ding"
        }
      ]
    },
    {
      "title": "ことば検定・声に出す四問",
      "lines": [
        {
          "sfx": "quiz"
        },
        {
          "who": "narrator",
          "text": "最後は四問！　答えは、ことばを声に出してね。"
        },
        {
          "who": "narrator",
          "text": "第一問。発表会の日をずっと楽しみに待っていた。『首を』の続きは？"
        },
        {
          "quiz_pause_ms": 4400
        },
        {
          "sfx": "ding"
        },
        {
          "who": "mika",
          "text": "首を長くする。楽しみに待ち続けること。"
        },
        {
          "who": "narrator",
          "text": "第二問。会議で誰も話し出さない。最初に意見を言って、何を切った？"
        },
        {
          "quiz_pause_ms": 4400
        },
        {
          "sfx": "ding"
        },
        {
          "who": "tomo",
          "text": "口火を切る！　ぼくも今日、最初に質問したのだ。"
        },
        {
          "who": "narrator",
          "text": "第三問。高い飛び込み台を前に、怖くてなかなか飛び込めない。どんな表現？"
        },
        {
          "quiz_pause_ms": 4600
        },
        {
          "sfx": "ding"
        },
        {
          "who": "manager",
          "text": "二の足を踏む。ためらって動けないことです。"
        },
        {
          "who": "narrator",
          "text": "第四問。接戦の最後の一球を、はらはらしながら見守る。何を握る？"
        },
        {
          "quiz_pause_ms": 4600
        },
        {
          "sfx": "ding"
        },
        {
          "who": "mika",
          "text": "手に汗を握る。緊張して見守ることだよ。"
        },
        {
          "who": "narrator",
          "text": "おまけの復習！　すごい技に感心するのは『舌を巻く』。新しい発見で理解できるのは『目から鱗が落ちる』。"
        },
        {
          "who": "tomo",
          "text": "六つ全部覚えたのだ！　肉まんの包み方もわかって、目から鱗が落ちたのだ！"
        },
        {
          "who": "manager",
          "text": "よくできたね。では、できたての肉まんをいただきましょう！"
        },
        {
          "sfx": "ending"
        }
      ]
    }
  ]
}
